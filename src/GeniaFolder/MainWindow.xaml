<Window x:Class="GeniaFolder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GeniaFolder" Height="650" Width="920"
        MinHeight="520" MinWidth="760"
        Icon="/GeniaFolder;component/Assets/GeniaFolder.ico"
        Background="{StaticResource WindowBackground}"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="GeniaFolder" FontSize="30" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
                <TextBlock Text="Умные цветные папки Windows" Margin="0,4,0,0" Foreground="{StaticResource TextSecondary}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Добавить папку" Click="AddFolder_Click" />
                <Button Content="Создать папку" Click="CreateFolder_Click" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Margin="0,24,0,14" Padding="14" CornerRadius="10" Background="#FFF8E1" BorderBrush="#F4D77D" BorderThickness="1">
            <TextBlock Text="Версия 0.2.0-alpha.4: восстановление vault работает и по паролю, и через бумажный Master Recovery Key." TextWrapping="Wrap" Foreground="#6B5715" />
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="FolderList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,10"
                                Padding="16"
                                Background="White"
                                CornerRadius="12"
                                BorderBrush="#E4E6EA"
                                BorderThickness="1"
                                Opacity="{Binding CardOpacity}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Background="{Binding ColorBrush}" CornerRadius="6" />

                                <StackPanel Grid.Column="1" Margin="14,0,16,0">
                                    <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
                                    <TextBlock Text="{Binding Path}" Margin="0,4,0,0" Foreground="{StaticResource TextSecondary}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Status}" Margin="0,5,0,0" FontSize="12" Foreground="{Binding StatusBrush}" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="Открыть"
                                            Tag="{Binding Id}"
                                            IsEnabled="{Binding Exists}"
                                            Click="Open_Click" />
                                    <Button Content="Цвет"
                                            Tag="{Binding Id}"
                                            IsEnabled="{Binding Exists}"
                                            Click="Color_Click" />
                                    <Button Content="{Binding ProtectionActionLabel}"
                                            Tag="{Binding Id}"
                                            IsEnabled="{Binding Exists}"
                                            Click="Protection_Click" />
                                    <Button Content="Убрать"
                                            Tag="{Binding Id}"
                                            Click="Remove_Click" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Window>
