<Window x:Class="GeniaFolder.Views.VaultDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Encrypted vault — GeniaFolder"
        Icon="/GeniaFolder;component/Assets/GeniaFolder.ico"
        Width="650"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Encrypted vault"
                   FontSize="22"
                   FontWeight="SemiBold" />

        <Border Grid.Row="1"
                Margin="0,14,0,0"
                Padding="14"
                Background="#F3F5F8"
                CornerRadius="8">
            <StackPanel>
                <TextBlock x:Name="SummaryText"
                           TextWrapping="Wrap" />
                <TextBlock x:Name="VaultPathText"
                           Margin="0,10,0,0"
                           Foreground="#59616D"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Border Grid.Row="2"
                Margin="0,16,0,0"
                Padding="12"
                Background="#EEF8F0"
                BorderBrush="#A7D7AF"
                BorderThickness="1"
                CornerRadius="8">
            <TextBlock Text="Vault уже прошёл полную криптографическую проверку. Восстановление создаёт новую отдельную папку; исходная папка и сам vault не изменяются."
                       TextWrapping="Wrap"
                       Foreground="#245D2E" />
        </Border>

        <StackPanel Grid.Row="3"
                    Margin="0,22,0,0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="Закрыть"
                    IsCancel="True"
                    Padding="16,7"
                    Margin="0,0,8,0" />
            <Button Content="Восстановить копию…"
                    Padding="16,7"
                    Click="Restore_Click" />
        </StackPanel>
    </Grid>
</Window>
