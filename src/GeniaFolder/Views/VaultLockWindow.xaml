<Window x:Class="GeniaFolder.Views.VaultLockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Заблокировать папку — GeniaFolder"
        Icon="/GeniaFolder;component/Assets/GeniaFolder.ico"
        Width="680"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Перевести папку в Vault-only"
                   FontSize="22"
                   FontWeight="SemiBold" />

        <Border Grid.Row="1"
                Margin="0,12,0,18"
                Padding="12"
                Background="#FDECEC"
                BorderBrush="#F1A7A7"
                BorderThickness="1"
                CornerRadius="8">
            <TextBlock x:Name="WarningText"
                       TextWrapping="Wrap"
                       Foreground="#7A1E1E" />
        </Border>

        <StackPanel Grid.Row="2">
            <TextBlock Text="Пароль папки"
                       FontWeight="SemiBold"
                       Margin="0,0,0,6" />
            <PasswordBox x:Name="PasswordBox"
                         MinHeight="36"
                         Padding="8,0"
                         VerticalContentAlignment="Center" />
        </StackPanel>

        <StackPanel Grid.Row="3" Margin="0,18,0,0">
            <CheckBox x:Name="RecoveryConfirmedBox"
                      Checked="Confirmation_Changed"
                      Unchecked="Confirmation_Changed">
                <TextBlock Text="Master Recovery Key записан и хранится отдельно от компьютера."
                           TextWrapping="Wrap"
                           Margin="4,0,0,0" />
            </CheckBox>

            <CheckBox x:Name="RemovalConfirmedBox"
                      Margin="0,10,0,0"
                      Checked="Confirmation_Changed"
                      Unchecked="Confirmation_Changed">
                <TextBlock Text="Я понимаю: после повторной криптографической проверки обычная plaintext-папка будет удалена из файловой системы. Физическое затирание SSD не обещается."
                           TextWrapping="Wrap"
                           Margin="4,0,0,0" />
            </CheckBox>
        </StackPanel>

        <StackPanel Grid.Row="4" Margin="0,18,0,0">
            <ProgressBar x:Name="ProgressBar"
                         Height="12"
                         Minimum="0"
                         Maximum="100"
                         Value="0" />
            <TextBlock x:Name="StatusText"
                       Margin="0,8,0,0"
                       Text="Готово к повторной проверке vault и исходной папки."
                       Foreground="#59616D"
                       TextWrapping="Wrap" />
            <TextBlock x:Name="ErrorText"
                       Margin="0,8,0,0"
                       Foreground="#B42318"
                       TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Row="5"
                    Margin="0,22,0,0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button x:Name="CancelButton"
                    Content="Отмена"
                    Padding="16,7"
                    Margin="0,0,8,0"
                    Click="Cancel_Click" />
            <Button x:Name="LockButton"
                    Content="Проверить и заблокировать"
                    IsDefault="True"
                    IsEnabled="False"
                    Padding="16,7"
                    Click="Lock_Click" />
        </StackPanel>
    </Grid>
</Window>
